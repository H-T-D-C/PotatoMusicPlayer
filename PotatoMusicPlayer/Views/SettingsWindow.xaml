<Window x:Class="PotatoMusicPlayer.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="設定" Height="360" Width="560" WindowStartupLocation="CenterOwner"
        Style="{StaticResource AppWindowStyle}" ResizeMode="NoResize">
    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="12" Background="{StaticResource BackgroundMediumBrush}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="160"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 左: カテゴリ -->
            <ListBox x:Name="CategoryList" Grid.Column="0" Grid.Row="0" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextLightBrush}" FontSize="12" SelectionChanged="CategoryList_SelectionChanged">
                <ListBoxItem Tag="General">一般</ListBoxItem>
                <ListBoxItem Tag="Volume">音量</ListBoxItem>
                <ListBoxItem Tag="Display">表示</ListBoxItem>
            </ListBox>

            <!-- 区切り -->
            <Border Grid.Column="1" Grid.Row="0" Background="{StaticResource BorderBrush}" Width="1"/>

            <!-- 右: 設定パネル -->
            <Grid Grid.Column="2" Grid.Row="0" Margin="8,0,0,0">
                <!-- General -->
                <StackPanel x:Name="GeneralPanel" Visibility="Collapsed">
                    <TextBlock Text="一般設定" FontSize="14" FontWeight="Bold" Margin="0,0,0,8" Foreground="{StaticResource TextLightBrush}"/>
                    <TextBlock Text="（今は項目がありません）" Foreground="{StaticResource TextDimBrush}"/>
                </StackPanel>

                <!-- Volume -->
                <StackPanel x:Name="VolumePanel" Visibility="Collapsed">
                    <TextBlock Text="音量設定" FontSize="14" FontWeight="Bold" Margin="0,0,0,8" Foreground="{StaticResource TextLightBrush}"/>

                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="60"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="音量の上限 (%)" Grid.Column="0" VerticalAlignment="Center" Foreground="{StaticResource TextLightBrush}"/>
                        <Slider x:Name="MaxVolumeSlider" Grid.Column="1" Minimum="100" Maximum="400" TickFrequency="10" IsSnapToTickEnabled="False" Height="24" VerticalAlignment="Center"/>
                        <TextBox x:Name="MaxVolumeText" Grid.Column="2" Width="52" Margin="8,0,0,0" VerticalContentAlignment="Center"/>
                    </Grid>

                    <TextBlock Text="(例: 200 = 200%)" Foreground="{StaticResource TextDimBrush}" FontSize="11" Margin="0,6,0,0"/>
                </StackPanel>

                <!-- Display -->
                <StackPanel x:Name="DisplayPanel" Visibility="Collapsed">
                    <TextBlock Text="表示設定" FontSize="14" FontWeight="Bold" Margin="0,0,0,8" Foreground="{StaticResource TextLightBrush}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4">
                        <TextBlock Text="波形表示" Width="160" VerticalAlignment="Center" Foreground="{StaticResource TextLightBrush}"/>
                        <CheckBox x:Name="ShowWaveformCheck" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- ボタン -->
            <StackPanel Orientation="Horizontal" Grid.Column="2" Grid.Row="1" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button x:Name="CancelButton" Background="#4D4D4D" Foreground="#DCDCDC" Content="キャンセル" Width="88" Height="28" Margin="0,0,8,0" Click="CancelButton_Click"/>
                <Button x:Name="ApplyButton" Background="#4D5D4D" Foreground="#DCDCDC" Content="適用" Width="88" Height="28" Margin="0,0,8,0" Click="ApplyButton_Click"/>
                <Button x:Name="OkButton" Background="#4D4D4D" Foreground="#DCDCDC" Content="OK" Width="88" Height="28" Click="OkButton_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>