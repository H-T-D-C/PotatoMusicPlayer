<Window x:Class="PotatoMusicPlayer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:PotatoMusicPlayer.Converters;assembly=PotatoMusicPlayer"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Potato Music Player"
        Width="900" Height="200"
        MinWidth="500" MinHeight="190"
        Background="{DynamicResource BackgroundDarkBrush}"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        AllowsTransparency="False">

    <Window.Resources>
        <DrawingImage x:Key="TaskbarPreviousIcon">
            <DrawingImage.Drawing>
                <GeometryDrawing Brush="White" Geometry="M 1,1 L 1,15 L 4,15 L 4,1 Z M 6,8 L 15,1 L 15,15 Z"/>
            </DrawingImage.Drawing>
        </DrawingImage>
        <DrawingImage x:Key="TaskbarPlayIcon">
            <DrawingImage.Drawing>
                <GeometryDrawing Brush="White" Geometry="M 3,1 L 15,8 L 3,15 Z"/>
            </DrawingImage.Drawing>
        </DrawingImage>
        <DrawingImage x:Key="TaskbarPauseIcon">
            <DrawingImage.Drawing>
                <GeometryDrawing Brush="White" Geometry="M 2,1 L 6,1 L 6,15 L 2,15 Z M 10,1 L 14,1 L 14,15 L 10,15 Z"/>
            </DrawingImage.Drawing>
        </DrawingImage>
        <DrawingImage x:Key="TaskbarNextIcon">
            <DrawingImage.Drawing>
                <GeometryDrawing Brush="White" Geometry="M 1,1 L 10,8 L 1,15 Z M 12,1 L 12,15 L 15,15 L 15,1 Z"/>
            </DrawingImage.Drawing>
        </DrawingImage>
    </Window.Resources>

    <Window.TaskbarItemInfo>
        <shell:TaskbarItemInfo x:Name="TaskbarInfo" Description="Potato Music Player">
            <shell:TaskbarItemInfo.ThumbButtonInfos>
                <shell:ThumbButtonInfo x:Name="TaskbarPreviousButton" Description="Previous" ImageSource="{StaticResource TaskbarPreviousIcon}" Click="TaskbarPrevious_Click"/>
                <shell:ThumbButtonInfo x:Name="TaskbarPlayPauseButton" Description="Play / Pause" ImageSource="{StaticResource TaskbarPlayIcon}" Click="TaskbarPlayPause_Click"/>
                <shell:ThumbButtonInfo x:Name="TaskbarNextButton" Description="Next" ImageSource="{StaticResource TaskbarNextIcon}" Click="TaskbarNext_Click"/>
            </shell:TaskbarItemInfo.ThumbButtonInfos>
        </shell:TaskbarItemInfo>
    </Window.TaskbarItemInfo>

    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- カスタムタイトルバー + メニュー -->
                <RowDefinition Height="Auto"/>
                <!-- メタデータ表示 -->
                <RowDefinition x:Name="WaveformRow" Height="56"/>
                <!-- 波形表示 -->
                <RowDefinition Height="Auto"/>
                <!-- トランスポートコントロール -->
                <RowDefinition Height="*"/>
                <!-- 伸縮スペーサー(上側は上に詰め、再生バーは下端に固定) -->
                <RowDefinition Height="Auto"/>
                <!-- 時間 / 再生バー -->
            </Grid.RowDefinitions>


            <!-- ============ タイトルバー(メニュー統合) ============ -->
            <Grid Grid.Row="0" Background="{DynamicResource BackgroundMediumBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Menu Grid.Column="1" Background="Transparent" Foreground="{DynamicResource TextLightBrush}" FontSize="11"
                      VerticalAlignment="Center" Padding="4,2" HorizontalAlignment="Right">
                    <Menu.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </Menu.ItemsPanel>
                    <MenuItem x:Name="FileMenuItem" Header="ファイル">
                        <MenuItem x:Name="FileOpenMenuItem" Header="開く..." Click="OpenFile_Click"/>
                        <MenuItem x:Name="FileOpenLocationMenuItem" Header="ファイルの場所を開く" Click="OpenFileLocation_Click"/>
                        <MenuItem x:Name="FileOpenTerminalMenuItem" Header="ターミナルで開く" Click="OpenInTerminal_Click"/>
                        <Separator/>
                        <MenuItem x:Name="RecentFilesMenuItem" Header="最近使ったファイル"/>
                        <Separator/>
                        <MenuItem x:Name="FileSettingsMenuItem" Header="設定..." Click="OpenSettings_Click"/>
                        <MenuItem x:Name="FileExitMenuItem" Header="終了" Click="Exit_Click"/>
                    </MenuItem>
                    <MenuItem x:Name="PlaybackMenuItem" Header="再生">
                        <MenuItem x:Name="PlaybackPlayPauseMenuItem" Header="再生/一時停止" Click="PlayPause_Click"/>
                        <MenuItem x:Name="PlaybackStopMenuItem" Header="停止" Click="Stop_Click"/>
                        <Separator/>
                        <MenuItem x:Name="PlaybackGoToStartMenuItem" Header="最初へ戻る" Click="GoToStart_Click"/>
                        <MenuItem x:Name="PlaybackSeekToTimeMenuItem" Header="指定時刻へ移動..." Click="SeekToTime_Click"/>
                        <Separator/>
                        <MenuItem x:Name="PlaybackSpeedResetMenuItem" Header="速度: 100%にセット" Click="SpeedReset_Click"/>
                        <MenuItem x:Name="PlaybackSpeedDecreaseMenuItem" Header="速度: 5%遅く" Click="SpeedDecrease_Click"/>
                        <MenuItem x:Name="PlaybackSpeedIncreaseMenuItem" Header="速度: 5%速く" Click="SpeedIncrease_Click"/>
                        <Separator/>
                        <MenuItem x:Name="PlaybackSkipForwardMenuItem" Header="5秒スキップ" Click="SkipForward_Click"/>
                        <MenuItem x:Name="PlaybackSkipBackwardMenuItem" Header="5秒戻る" Click="SkipBackward_Click"/>
                    </MenuItem>
                    <MenuItem x:Name="ViewMenuItem" Header="表示">
                        <MenuItem x:Name="AlwaysOnTopMenuItem" Header="常に最前面" IsCheckable="True" Click="AlwaysOnTop_Click"/>
                        <MenuItem x:Name="FixWindowSizeMenuItem" Header="ウィンドウサイズ固定" IsCheckable="True" Click="FixWindowSize_Click"/>
                        <MenuItem x:Name="WaveformMenuItem" Header="波形">
                            <MenuItem x:Name="ShowWaveformMenuItem" Header="波形を表示" IsCheckable="True" IsChecked="True" Click="ShowWaveform_Click"/>
                            <MenuItem x:Name="CenterFixedWaveformMenuItem" Header="再生ヘッドを中央に固定" IsCheckable="True" Click="CenterFixedWaveform_Click"/>
                            <Separator/>
                            <MenuItem x:Name="WaveformRangeMenuItem" Header="範囲を指定して拡大..." Click="WaveformRange_Click"/>
                        </MenuItem>
                        <Separator/>
                        <MenuItem x:Name="ThemeMenuItem" Header="モード">
                            <MenuItem x:Name="ThemeLightMenuItem" Header="ライト" Tag="Light" IsCheckable="True" Click="ThemeMenuItem_Click"/>
                            <MenuItem x:Name="ThemeDarkMenuItem" Header="ダーク" Tag="Dark" IsCheckable="True" Click="ThemeMenuItem_Click"/>
                            <MenuItem x:Name="ThemeSystemMenuItem" Header="システム" Tag="System" IsCheckable="True" Click="ThemeMenuItem_Click"/>
                        </MenuItem>
                        <MenuItem x:Name="ViewFullScreenMenuItem" Header="全画面表示" Click="FullScreen_Click"/>
                    </MenuItem>
                    <MenuItem x:Name="OtherMenuItem" Header="その他">
                        <MenuItem x:Name="OtherAboutMenuItem" Header="バージョン情報" Click="About_Click"/>
                    </MenuItem>
                </Menu>
                <!-- アイコン領域はドラッグ可能なタイトルバー領域としても使用する -->
                <Border Grid.Column="0" Padding="8,0,6,0" Background="Transparent"
                        MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="pack://application:,,,/potato.png" Width="16" Height="16"
                               Stretch="Uniform" SnapsToDevicePixels="True"/>
                    </StackPanel>
                </Border>

                <!-- メニューや操作ボタンと重ならないドラッグ専用領域 -->
                <Border Grid.Column="2" Background="Transparent"
                        MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"/>

                <!-- 最小化・閉じるボタン -->
                <StackPanel Grid.Column="3" Orientation="Horizontal">
                    <Button Content="—" Width="32" Height="26" Style="{StaticResource WindowControlButtonStyle}" Background="Transparent" Foreground="{DynamicResource TextLightBrush}"
                            BorderThickness="0" Click="Minimize_Click"/>
                    <Button Content="✕" Width="32" Height="26" Style="{StaticResource CloseButtonStyle}" Background="Transparent" Foreground="{DynamicResource TextLightBrush}"
                            BorderThickness="0" Click="Close_Click"/>
                </StackPanel>
            </Grid>

            <!-- ============ メタデータ表示 ============ -->
            <StackPanel Grid.Row="1" Margin="8,4,8,2">
                        <TextBlock x:Name="TitleText" Text="再生するファイルがありません" Style="{StaticResource TitleTextStyle}"/>
                <TextBlock x:Name="ArtistText" Text="" Foreground="{DynamicResource TextDimBrush}" FontSize="11"/>
            </StackPanel>

            <!-- ============ 波形表示エリア ============ -->
            <Grid Grid.Row="2" Margin="8,2,8,2">
                <!-- 時刻表示と同じ列幅を確保し、波形の左右端をシークバーに揃える -->
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="00:00" Foreground="Transparent"
                           FontFamily="Consolas" FontSize="10" Margin="0,0,6,0"/>
                <Border x:Name="WaveformContainer" Grid.Column="1"
                        Background="{DynamicResource WaveformBackgroundBrush}" CornerRadius="2">
                    <Grid>
                <Canvas x:Name="WaveformCanvas" Background="Transparent" ClipToBounds="True"
                                PreviewMouseWheel="WaveformCanvas_PreviewMouseWheel"
                                PreviewMouseLeftButtonDown="WaveformCanvas_PreviewMouseLeftButtonDown"
                                PreviewMouseMove="WaveformCanvas_PreviewMouseMove"
                                PreviewMouseLeftButtonUp="WaveformCanvas_PreviewMouseLeftButtonUp"
                                SizeChanged="WaveformCanvas_SizeChanged"/>
                        <TextBlock x:Name="WaveformProgressText" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextDimBrush}" FontSize="11" Visibility="Collapsed" IsHitTestVisible="False"/>
                    </Grid>
                </Border>
                <TextBlock x:Name="WaveformRangeText" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,-13,0,0"
                           Foreground="{DynamicResource TextDimBrush}" FontSize="10" Cursor="Hand"
                           MouseLeftButtonUp="WaveformRangeText_MouseLeftButtonUp"/>
                <TextBlock Grid.Column="2" Text="00:00" Foreground="Transparent"
                           FontFamily="Consolas" FontSize="10" Margin="6,0,0,0"/>
            </Grid>

            <!-- ============ トランスポートコントロール ============ -->
            <Grid Grid.Row="5" Margin="8,2,8,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 左: 再生系ボタン -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button x:Name="PrevButton" Content="⏮" Style="{StaticResource TransportButtonStyle}" Click="GoToStart_Click"/>
                    <Button x:Name="PlayPauseButton" Content="▶" Style="{StaticResource TransportButtonStyle}" Click="PlayPause_Click"/>
                    <Button x:Name="StopButton" Content="⏹" Style="{StaticResource TransportButtonStyle}" Click="Stop_Click"/>
                    <Button x:Name="NextButton" Content="⏭" Style="{StaticResource TransportButtonStyle}" Click="Stop_Click"/>
                </StackPanel>

                <!-- 中央: 速度・ループ表示 -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock x:Name="SpeedText" Text="1.0x" Foreground="{DynamicResource TextDimBrush}" FontSize="10" Margin="4,0" VerticalAlignment="Center"/>
                    <Button x:Name="LoopButton" Content="Loop: OFF" Style="{StaticResource SettingsInputButtonStyle}" Background="Transparent" Foreground="{DynamicResource TextDimBrush}"
                            BorderBrush="Transparent" BorderThickness="1" FontSize="10" Padding="4,1" Click="ToggleLoop_Click"/>
                </StackPanel>

                <!-- 右: 音量 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                            MouseWheel="VolumeArea_MouseWheel">
                    <Image x:Name="VolumeIcon" Source="pack://application:,,,/Resources/Icons/speaker_dark_3.png"
                           Width="16" Height="16" Stretch="Uniform" Margin="0,0,4,0"
                           ToolTip="ミュート切り替え" Cursor="Hand"
                           MouseLeftButtonUp="VolumeIcon_MouseLeftButtonUp"/>
                    <Slider x:Name="VolumeSlider" Width="70" Height="18" Minimum="0" Maximum="200" Value="80"
                            VerticalAlignment="Center" ValueChanged="VolumeSlider_ValueChanged"/>
                    <TextBlock x:Name="VolumeText" Text="80%" Foreground="{DynamicResource TextDimBrush}" FontSize="10" Margin="6,0,0,0" VerticalAlignment="Center" Width="26" TextAlignment="Right"/>
                </StackPanel>
            </Grid>

            <!-- ============ 時間表示 / 再生バー(下端に固定) ============ -->
            <Grid Grid.Row="3" Margin="8,2,8,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition x:Name="MinimapRow" Height="18"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="CurrentTimeText" Grid.Row="0" Grid.Column="0" Text="00:00" Foreground="{DynamicResource TextDimBrush}"
                           FontFamily="Consolas" FontSize="10" VerticalAlignment="Center" Margin="0,0,6,0"/>

                <Slider x:Name="SeekBar" Grid.Row="0" Grid.Column="1" Minimum="0" Maximum="100" Value="0"
                        VerticalAlignment="Center"
                        PreviewMouseLeftButtonDown="SeekBar_PreviewMouseLeftButtonDown"
                        PreviewMouseMove="SeekBar_PreviewMouseMove"
                        PreviewMouseLeftButtonUp="SeekBar_PreviewMouseLeftButtonUp"/>

                <TextBlock x:Name="TotalTimeText" Grid.Row="0" Grid.Column="2" Text="00:00" Foreground="{DynamicResource TextDimBrush}"
                           FontFamily="Consolas" FontSize="10" VerticalAlignment="Center" Margin="6,0,0,0"/>

                <Border x:Name="MinimapContainer" Grid.Row="1" Grid.Column="1" Margin="0,2,0,0"
                        Background="#30343A" CornerRadius="2" ClipToBounds="True">
                    <Canvas x:Name="MinimapCanvas" Background="Transparent" ClipToBounds="True"
                            PreviewMouseLeftButtonDown="MinimapCanvas_PreviewMouseLeftButtonDown"
                            PreviewMouseMove="MinimapCanvas_PreviewMouseMove"
                            PreviewMouseLeftButtonUp="MinimapCanvas_PreviewMouseLeftButtonUp"
                            SizeChanged="MinimapCanvas_SizeChanged"/>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
