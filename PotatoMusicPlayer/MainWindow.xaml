<Window x:Class="PotatoMusicPlayer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:PotatoMusicPlayer.Converters;assembly=PotatoMusicPlayer"
        Title="Potato Music Player"
        Width="900" Height="400"
        MinWidth="500" MinHeight="220"
        Background="#1E1E1E"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        AllowsTransparency="False">

    <Border BorderBrush="#4A4A4A" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- カスタムタイトルバー + メニュー -->
                <RowDefinition Height="Auto"/>
                <!-- メタデータ表示 -->
                <RowDefinition Height="Auto"/>
                <!-- 時間 / 再生バー -->
                <RowDefinition Height="*"/>
                <!-- 波形表示 -->
                <RowDefinition Height="Auto"/>
                <!-- トランスポートコントロール -->
            </Grid.RowDefinitions>

            <!-- ============ タイトルバー(メニュー統合) ============ -->
            <Grid Grid.Row="0" Background="#2D2D2D" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Menu Grid.Column="0" Background="Transparent" Foreground="#DCDCDC" FontSize="11"
                      VerticalAlignment="Center" Padding="4,2" Margin="0,0,406,0">
                    <MenuItem Header="ファイル">
                        <MenuItem Header="開く..." Click="OpenFile_Click"/>
                        <MenuItem Header="ファイルの場所を開く" Click="OpenFileLocation_Click"/>
                        <MenuItem Header="ターミナルで開く" Click="OpenInTerminal_Click"/>
                        <Separator/>
                        <MenuItem x:Name="RecentFilesMenuItem" Header="最近使ったファイル"/>
                        <Separator/>
                        <MenuItem Header="終了" Click="Exit_Click"/>
                    </MenuItem>
                    <MenuItem Header="再生">
                        <MenuItem Header="再生/一時停止" Click="PlayPause_Click"/>
                        <MenuItem Header="停止" Click="Stop_Click"/>
                        <Separator/>
                        <MenuItem Header="最初へ戻る" Click="GoToStart_Click"/>
                        <Separator/>
                        <MenuItem Header="速度: 100%にセット" Click="SpeedReset_Click"/>
                        <MenuItem Header="速度: 5%遅く" Click="SpeedDecrease_Click"/>
                        <MenuItem Header="速度: 5%速く" Click="SpeedIncrease_Click"/>
                        <Separator/>
                        <MenuItem Header="5秒スキップ" Click="SkipForward_Click"/>
                        <MenuItem Header="5秒戻る" Click="SkipBackward_Click"/>
                    </MenuItem>
                    <MenuItem Header="編集">
                        <MenuItem Header="設定..." Click="OpenSettings_Click"/>
                    </MenuItem>
                    <MenuItem Header="表示">
                        <MenuItem x:Name="AlwaysOnTopMenuItem" Header="常に最前面" IsCheckable="True" Click="AlwaysOnTop_Click"/>
                        <MenuItem x:Name="FixWindowSizeMenuItem" Header="ウィンドウサイズ固定" IsCheckable="True" Click="FixWindowSize_Click"/>
                        <MenuItem x:Name="ShowWaveformMenuItem" Header="波形を表示" IsCheckable="True" IsChecked="True" Click="ShowWaveform_Click"/>
                        <Separator/>
                        <MenuItem Header="全画面表示" Click="FullScreen_Click"/>
                    </MenuItem>
                    <MenuItem Header="その他">
                        <MenuItem Header="バージョン情報" Click="About_Click"/>
                    </MenuItem>
                </Menu>

                <!-- 最小化・閉じるボタン -->
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="—" Width="32" Height="26" Background="Transparent" Foreground="#DCDCDC"
                            BorderThickness="0" Click="Minimize_Click"/>
                    <Button Content="✕" Width="32" Height="26" Background="Transparent" Foreground="#DCDCDC"
                            BorderThickness="0" Click="Close_Click"/>
                </StackPanel>
            </Grid>

            <!-- ============ メタデータ表示 ============ -->
            <StackPanel Grid.Row="1" Margin="8,4,8,2">
                <TextBlock x:Name="TitleText" Text="再生するファイルがありません" Style="{StaticResource TitleTextStyle}"/>
                <TextBlock x:Name="ArtistText" Text="" Foreground="#969696" FontSize="11"/>
            </StackPanel>

            <!-- ============ 時間表示 / 再生バー ============ -->
            <Grid Grid.Row="2" Margin="8,0,8,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="CurrentTimeText" Grid.Column="0" Text="00:00" Foreground="#969696"
                           FontFamily="Consolas" FontSize="10" VerticalAlignment="Center" Margin="0,0,6,0"/>

                <Slider x:Name="SeekBar" Grid.Column="1" Minimum="0" Maximum="100" Value="0"
                        VerticalAlignment="Center"
                        PreviewMouseLeftButtonDown="SeekBar_PreviewMouseLeftButtonDown"
                        PreviewMouseMove="SeekBar_PreviewMouseMove"
                        PreviewMouseLeftButtonUp="SeekBar_PreviewMouseLeftButtonUp"/>

                <TextBlock x:Name="TotalTimeText" Grid.Column="2" Text="00:00" Foreground="#969696"
                           FontFamily="Consolas" FontSize="10" VerticalAlignment="Center" Margin="6,0,0,0"/>
            </Grid>

            <!-- ============ 波形表示エリア ============ -->
            <Border x:Name="WaveformContainer" Grid.Row="3" Margin="8,2,8,2"
                    Background="#2D2D2D" CornerRadius="2">
                <Canvas x:Name="WaveformCanvas" ClipToBounds="True"/>
            </Border>

            <!-- ============ トランスポートコントロール ============ -->
            <Grid Grid.Row="4" Margin="8,2,8,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 左: 再生系ボタン -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button x:Name="PrevButton" Content="⏮" Style="{StaticResource TransportButtonStyle}" Click="GoToStart_Click"/>
                    <Button x:Name="PlayPauseButton" Content="▶" Style="{StaticResource TransportButtonStyle}" Click="PlayPause_Click"/>
                    <Button x:Name="StopButton" Content="⏹" Style="{StaticResource TransportButtonStyle}" Click="Stop_Click"/>
                    <Button x:Name="NextButton" Content="⏭" Style="{StaticResource TransportButtonStyle}" Click="Stop_Click"/>
                </StackPanel>

                <!-- 中央: 速度・ループ表示 -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock x:Name="SpeedText" Text="1.0x" Foreground="#969696" FontSize="10" Margin="4,0" VerticalAlignment="Center"/>
                    <Button x:Name="LoopButton" Content="Loop: OFF" Background="Transparent" Foreground="#969696"
                            BorderThickness="0" FontSize="10" Click="ToggleLoop_Click"/>
                </StackPanel>

                <!-- 右: 音量 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🔊" FontSize="12" Margin="0,0,4,0" VerticalAlignment="Center"/>
                    <Slider x:Name="VolumeSlider" Width="70" Minimum="0" Maximum="200" Value="80"
                            VerticalAlignment="Center" ValueChanged="VolumeSlider_ValueChanged"/>
                    <TextBlock x:Name="VolumeText" Text="80%" Foreground="#969696" FontSize="10" Margin="6,0,0,0" VerticalAlignment="Center" Width="26" TextAlignment="Right"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
